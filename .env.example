# Optional planner gateway. The endpoint must implement the AIQA planner contract documented in README.md.
AIQA_PLANNER_ENDPOINT=
AIQA_PLANNER_TOKEN=

# Optional screenshot evidence gateway. HTTPS is required except for localhost/loopback.
# When configured, defect screenshots may be sent to this endpoint for confirm/reject/uncertain evidence assessment.
AIQA_VISUAL_ENDPOINT=
AIQA_VISUAL_TOKEN=

# Versionable deterministic visual-regression manifest used for new/persistent/resolved classification.
AIQA_VISUAL_BASELINE=.qa-baselines/visual.json

# MiniMax CN direct provider. When MINIMAX_API_KEY is set and no explicit AIQA planner/UX gateway
# is configured, MiniMax is used for planner ranking and aggregate-only UX reasoning.
# The friendly alias minimax-m3 is normalized to the official MiniMax-M3 model id at request time.
MINIMAX_API_KEY=
MINIMAX_MODEL=minimax-m3
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
# Per-attempt timeout and bounded transient retries. Empty values are treated as unset.
MINIMAX_TIMEOUT_MS=45000
MINIMAX_RETRY_ATTEMPTS=3

# Optional provider keys reserved for later adapters.
OPENAI_API_KEY=
APPLITOOLS_API_KEY=
QA_TECH_API_KEY=
